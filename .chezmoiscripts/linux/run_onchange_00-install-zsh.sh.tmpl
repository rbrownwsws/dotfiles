{{- if eq .chezmoi.osRelease.idLike "debian" -}}
#!/usr/bin/env sh
set -eu

if [ -t 0 ]; then
  printf "Try to install zsh via apt-get? [y/N] "
  read -r answer
else
  answer="n"
fi

case "$answer" in
  [Yy]*)
    echo ""
    echo "### Install/update zsh ###"
    echo ""

    sudo apt-get update -y
    sudo apt-get install -y zsh
    ;;

  *)
    echo "Skipping zsh install (no TTY or declined)."
    ;;
esac
{{- end -}}

